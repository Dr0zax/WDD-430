---
import Layout from '../layouts/Layout.astro';
---

<Layout title="About | Drozax Music" description="Learn about Drozax, the music, the studio, and ways to get in touch.">
    <section aria-labelledby="about-heading">
        <header>
            <h1 id="about-heading">About Drozax</h1>
            <p>Based in Idaho, Drozax writes chillsynth inspired by listening to artists like HOME, Voyage, Hotel Pools, and Eagle EyedTiger on Electronic Gems. They started writing music in 2019 and released their first album, “Reflections,” in May 2024. On December 2, 2024, Drozax's track “Sequence” from their second album was featured by Electronic Gems alongside other artists they drew inspiration from</p>
        </header>
    </section>

    <section id="social-links" aria-labelledby="links-heading">
        <h2 id="links-heading">Find Drozax online</h2>
        <ul>
            <li><a href="https://drozax.bandcamp.com/music" target="_blank" rel="noreferrer">Bandcamp</a></li>
            <li><a href="https://soundcloud.com/drozax" target="_blank" rel="noreferrer">SoundCloud</a></li>
            <li><a href="https://www.youtube.com/channel/UCABb0dsFe0_xwGE9oON3NLQ" target="_blank" rel="noreferrer">YouTube</a></li>
        </ul>
    </section>

    <section id="contact" aria-labelledby="contact-heading">
        <h2 id="contact-heading">Contact</h2>
        <p>For queries and questions email me at <a href="mailto:hello@example.com">drozaxmusic@example.com</a>.</p>
    </section>
</Layout>
