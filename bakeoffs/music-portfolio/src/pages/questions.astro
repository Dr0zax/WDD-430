---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Questions | Drozax Music" description="Ask Drozax a question and read published questions and answers.">
    <section aria-labelledby="questions-heading">
        <header>
            <h1 id="questions-heading">Questions</h1>
            <p>Ask about the music, studio, gear, or creative process.</p>
        </header>

        <form method="post" aria-describedby="question-note">
            <p id="question-note">Questions are reviewed before they are published. Email addresses are kept private.</p>

            <div>
                <label for="visitor-name">Name or display name <span>(optional)</span></label>
                <input id="visitor-name" name="visitor_name" type="text" autocomplete="name" />
            </div>

            <div>
                <label for="visitor-email">Email address <span>(optional)</span></label>
                <input id="visitor-email" name="visitor_email" type="email" autocomplete="email" />
            </div>

            <div>
                <label for="question-text">Question</label>
                <textarea id="question-text" name="question_text" rows="6" required></textarea>
            </div>

            <div>
                <label for="website">Leave this field blank</label>
                <input id="website" name="website" type="text" autocomplete="off" tabindex="-1" />
            </div>

            <label>
                <input name="consent" type="checkbox" required />
                I understand that my question may be published with my display name.
            </label>
            <button type="submit">Submit question</button>
        </form>
    </section>

    <section aria-labelledby="answers-heading">
        <h2 id="answers-heading">Published questions and answers</h2>
        <div id="published-questions">
            <article>
                <h3>Example visitor question</h3>
                <p>Published question text will appear here after administrator approval.</p>
                <p><strong>Answer:</strong> The artist's answer will appear here.</p>
            </article>
        </div>
    </section>
</Layout>
