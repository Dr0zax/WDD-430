---
import Layout from '../layouts/Layout.astro';
import FeaturedRelease from '../components/FeaturedRelease.astro';
import { createServerClient } from '../db/supabase';

const supabase = createServerClient();
const { data: featured_release, error } = await supabase.from("music_entries").select();
---

<Layout title="Drozax Music">
    <section class="hero">
        <div class="hero-heading">
            <h1>Drozax Music</h1>
            <p>Chillsynth and chillwave</p>
        </div>
    </section>

    <section class="featured-releases">
        <h2 id="featured-heading">Featured release</h2>
        <article>
            {featured_release?.map((release)=> {
                return <FeaturedRelease 
                    title={release.title}
                    release_date={release.release_date}
                    description={release.description}
                />
            })}
            <a href="/music">Explore the music catalog</a>
        </article>
    </section>

    <section class="page-nav">
        <h2 id="start-heading">Explore the site</h2>
        <nav aria-label="Homepage sections">
            <a href="/about">Read about Drozax</a>
            <a href="/questions">Ask a question</a>
        </nav>
    </section>
</Layout>

