---
import Layout from '../layouts/Layout.astro';
---

<Layout title="About | Drozax Music" description="Learn about Drozax, the music, the studio, and ways to get in touch.">
    <section aria-labelledby="about-heading">
        <header>
            <h1 id="about-heading">About Drozax</h1>
            <p>Background, influences, and contact information.</p>
        </header>

        <figure>
            <img src="/images/artist-placeholder.jpg" alt="Portrait or studio photograph of Drozax" />
            <figcaption>Drozax in the studio.</figcaption>
        </figure>
    </section>

    <section aria-labelledby="biography-heading">
        <h2 id="biography-heading">Biography</h2>
        <p>The artist biography will be managed as editable site content.</p>
    </section>

    <section aria-labelledby="statement-heading">
        <h2 id="statement-heading">Artistic statement</h2>
        <p>Drozax explores atmosphere, texture, and nostalgia through chillsynth and chillwave.</p>
    </section>

    <section aria-labelledby="credits-heading">
        <h2 id="credits-heading">Selected credits</h2>
        <ul>
            <li>Credit or collaboration will be loaded from the site content.</li>
        </ul>
    </section>

    <section id="social-links" aria-labelledby="links-heading">
        <h2 id="links-heading">Find Drozax online</h2>
        <ul>
            <li><a href="https://bandcamp.com" target="_blank" rel="noreferrer">Bandcamp</a></li>
            <li><a href="https://soundcloud.com" target="_blank" rel="noreferrer">SoundCloud</a></li>
            <li><a href="https://www.youtube.com" target="_blank" rel="noreferrer">YouTube</a></li>
        </ul>
    </section>

    <section id="contact" aria-labelledby="contact-heading">
        <h2 id="contact-heading">Contact</h2>
        <p>For booking, press, or collaboration inquiries, email <a href="mailto:hello@example.com">hello@example.com</a>.</p>
    </section>
</Layout>
