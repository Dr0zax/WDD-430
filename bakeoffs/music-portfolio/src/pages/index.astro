---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Drozax Music | Chillsynth and Chillwave">
    <section aria-labelledby="welcome-heading">
        <header>
            <p>Drozax Music</p>
            <h1 id="welcome-heading">Chillsynth and chillwave</h1>
            <p>Atmospheric electronic music, studio experiments, and sounds from the edge of the night.</p>
        </header>

        <figure>
            <img src="/images/hero-placeholder.jpg" alt="Abstract artwork representing Drozax music" />
            <figcaption>Welcome to the Drozax music portfolio.</figcaption>
        </figure>
    </section>

    <section aria-labelledby="featured-heading">
        <h2 id="featured-heading">Featured release</h2>
        <article>
            <h3>Featured release title</h3>
            <p>Album, EP, or single description will be loaded from the music catalog.</p>
            <a href="/music">Explore the music catalog</a>
        </article>
    </section>

    <section aria-labelledby="studio-heading">
        <h2 id="studio-heading">Studio highlight</h2>
        <p>A rotating selection of instruments, recording equipment, and tools used to make the music.</p>
        <a href="/gear">Browse the gear inventory</a>
    </section>

    <section aria-labelledby="start-heading">
        <h2 id="start-heading">Explore the site</h2>
        <nav aria-label="Homepage sections">
            <a href="/about">Read about Drozax</a>
            <a href="/questions">Ask a question</a>
        </nav>
    </section>
</Layout>
